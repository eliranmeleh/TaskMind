<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>Hello world!</h1>

    <form action="/api/tasks" method="POST">
      <input type="text" name="title" placeholder="Enter task title" required />
      <button type="submit">Add Task</button>
    </form>

    <% if (typeof error !== "undefined" && error.type === "duplicate") { %>
      <p style="color: red; font-weight: bold;">Task Already exists!</p>
    <% } %>

    <form action="/api/tasks/delete" method="POST">
      <input type="text" name="title" placeholder="Enter task title" required />
      <button type="submit">Delete Task</button>
    </form>

    <% if (typeof error !== "undefined" && error.type === "not exists") { %>
      <p style="color: red; font-weight: bold;">Task Doesn't exists!</p>
    <% } %>

    <ul>
        <%tasks.forEach((task)=> { %>
        <li>
            <form action="/api/tasks/task-complete" method="POST">
                <label>
                  <input type="hidden" name="title" value="<%= task.title %>" />
                  <%= task.title %>
                  <input type="checkbox" name="status" <%= task.status === 'done' ? 'checked' : '' %> onchange="this.form.submit()" />
                  <%= task.status %>
                </label>
            </form>
        </li>
        <%}) %>
    </ul>

    <script>
      if (exists) {
        
      }
    </script>

    <script src="index.js" charset="UTF-8"></script>
</script>
</body>
</html>